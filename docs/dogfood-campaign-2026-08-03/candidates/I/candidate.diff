+test("renders workflow progress for zero, partial, normalized, and complete stages", () => {
+  return withWorkspace(async ({ CommandCentre }) => {
+    const renderCommandCentre = (task) =>
+      renderToStaticMarkup(
+        React.createElement(CommandCentre, {
+          runtimeTasks: [task],
+          runtimeStatus: {
+            available: true,
+            authenticated: true,
+            authMethod: "codex-cli",
+            model: "gpt-5.6-luna",
+            reasoning: "xhigh",
+            binary: "codex",
+          },
+          runtimeLoading: false,
+          runtimeError: null,
+          runtimeRefreshing: false,
+          onNewTask: () => {},
+          onOpenTask: () => {},
+          onSeeAllTasks: () => {},
+          onRefreshRuntime: () => {},
+        }),
+      );
+
+    const assertProgress = (markup, { count, percentage, complete = false }) => {
+      const progress = markup.match(/<div class="[^"]*progress-ring[^"]*"[^>]*>/)?.[0];
+      assert.ok(progress, "workflow progress ring should render");
+      assert.match(progress, new RegExp(`aria-valuemin="0"`));
+      assert.match(progress, new RegExp(`aria-valuemax="10"`));
+      assert.match(progress, new RegExp(`aria-valuenow="${count}"`));
+      assert.match(progress, new RegExp(`aria-valuetext="${count} of 10 workflow stages complete"`));
+      assert.match(progress, new RegExp(`style="--workflow-progress:${percentage}%"`));
+      assert.match(markup, new RegExp(`<span>${count}\/10<\\/span>`));
+      if (complete) {
+        assert.match(progress, /class="progress-ring progress-ring--complete"/);
+      } else {
+        assert.doesNotMatch(progress, /progress-ring--complete/);
+      }
+    };
+
+    assertProgress(renderCommandCentre(createTask({ completedStages: [] })), { count: 0, percentage: 0 });
+    assertProgress(
+      renderCommandCentre(
+        createTask({
+          completedStages: ["triage", "triage", "scouts", "unknown-stage", "grill", "grill", "specification"],
+        }),
+      ),
+      { count: 4, percentage: 40 },
