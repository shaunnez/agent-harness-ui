+export function getCompletedStageProgress(completedStages: readonly string[]) {
+  const totalStages = workflowStages.length;
+  const validStageIds = new Set(workflowStages.map((stage) => stage.id));
+  const uniqueCompletedStageCount = new Set(
+    completedStages.filter((stageId) => validStageIds.has(stageId as StageId)),
+  ).size;
+  const completedStageCount = Math.min(uniqueCompletedStageCount, totalStages, 10);
+
+  return {
+    completedStageCount,
+    completedStagePercentage: totalStages
+      ? Math.round((completedStageCount / totalStages) * 100)
+      : 0,
+  };
+}
