+test("renders Skill provenance with distinct boundary, source, persisted, and UI layers", () => {
+  return withWorkspace(async ({ getSkillContract }) => {
+    const modelStages = ["triage", "scouts", "grill", "specification", "plan", "implement", "dev-review", "test", "final-review"];
+    for (const stageId of modelStages) {
+      const contract = getSkillContract(stageId);
+      assert.equal(contract.provider, "codex");
+      assert.equal(contract.input[0].sourceFile, "src/domain.ts");
+      assert.equal(contract.input[0].typeName, "RuntimeTask");
+      assert.equal(contract.output[0].typeName, "RuntimeArtifact");
+      assert.equal(contract.persistedArtifact.type.typeName, "RuntimeArtifact");
+      assert.equal(contract.presentation.layer, "ui-presentation");
+      assert.equal(contract.presentation.uiOnly, true);
+      assert.equal(contract.presentation.sourceFile, "src/components/LibraryScreens.tsx");
+      assert.equal(contract.presentation.symbol, "SkillsScreen");
+      assert.ok(contract.prompts.length > 0);
+      for (const source of [...contract.prompts, ...contract.parsers]) {
+        assert.ok(source.excerpt.includes(source.symbol), `${stageId} source excerpt names ${source.symbol}`);
+        assert.ok(source.lineStart > 0);
+        assert.ok(source.lineEnd >= source.lineStart);
+      }
+    }
+
+    const scouts = getSkillContract("scouts");
+    assert.deepEqual(
+      { filename: scouts.prompts[0].filename, symbol: scouts.prompts[0].symbol, layer: scouts.prompts[0].layer },
+      { filename: "server/scouts.mjs", symbol: "buildScoutRequest", layer: "prompt-source" },
+    );
+    assert.deepEqual(
+      { filename: scouts.parsers[0].filename, symbol: scouts.parsers[0].symbol, layer: scouts.parsers[0].layer },
+      { filename: "server/scouts.mjs", symbol: "parseScoutReport", layer: "parser-source" },
+    );
+
+    const grill = getSkillContract("grill");
+    assert.equal(grill.parsers[0].filename, "server/structured-output.mjs");
+    assert.equal(grill.parsers[0].symbol, "parseGrillQuestions");
+    assert.equal(grill.parsers[0].parsedType, "RuntimeGrillQuestion[]");
+
+    const plan = getSkillContract("plan");
+    assert.equal(plan.parsers[0].symbol, "parseWorkPackages");
+    assert.equal(plan.parsers[0].parsedType, "RuntimeWorkPackage[]");
+
+    const focusedTest = getSkillContract("test");
+    assert.equal(focusedTest.parsers.find((parser) => parser.symbol === "parseFocusedTestEvidence").parsedType, "RuntimeFocusedTestEvidence");
+
+    const approval = getSkillContract("approval");
+    assert.equal(approval.provider, "harness");
+    assert.equal(approval.configuration, null);
+    assert.deepEqual(approval.prompts, []);
+    assert.deepEqual(approval.parsers, []);
+    assert.equal(approval.persistedArtifact, null);
+    assert.equal(approval.persistedRecords[0].type.typeName, "RuntimeApproval");
+    assert.match(approval.notes.join(" "), /no prompt, parser, RuntimeAgentPolicy/i);
+    assert.match(approval.persistedRecords[0].description, /deterministic and harness-owned/i);
+    assert.equal(approval.presentation.uiOnly, true);
+  });
+});
