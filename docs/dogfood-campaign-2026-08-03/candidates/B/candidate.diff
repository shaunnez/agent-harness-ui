+test("restricts policy drafts to the allowlist and preserves reset payload semantics", () => {
+  return withWorkspace(async ({ availablePolicyModels, validatePolicyDraft, policySettingsPayload, policyIdForRole }) => {
+    const catalog = createPolicyCatalog();
+    const settings = createPolicySettings();
+
+    assert.deepEqual(
+      availablePolicyModels(catalog, settings.allowedModels).map((model) => model.id),
+      ["gpt-5.6-sol", "gpt-5.6-luna"],
+    );
+    assert.equal(policyIdForRole("scout-test-inventory"), "scouts");
+    assert.equal(policyIdForRole("approval"), null);
+    assert.equal(policyIdForRole("plan"), "plan");
+
+    const valid = validatePolicyDraft({ model: "gpt-5.6-sol", reasoning: "max" }, catalog, settings.allowedModels);
+    assert.equal(valid.valid, true);
+    assert.equal(valid.model.id, "gpt-5.6-sol");
+
+    const unsupportedReasoning = validatePolicyDraft(
+      { model: "gpt-5.6-luna", reasoning: "max" },
+      catalog,
+      settings.allowedModels,
+    );
+    assert.equal(unsupportedReasoning.valid, false);
+    assert.match(unsupportedReasoning.message, /not supported/i);
+
+    const disallowedModel = validatePolicyDraft(
+      { model: "gpt-5.6-terra", reasoning: "medium" },
+      catalog,
+      settings.allowedModels,
+    );
+    assert.equal(disallowedModel.valid, false);
+    assert.match(disallowedModel.message, /allowlist/i);
+
+    const resetPayload = policySettingsPayload(settings, "plan", {
+      model: settings.defaultModel,
+      reasoning: settings.defaultReasoning,
+    });
+    assert.deepEqual(resetPayload.stagePolicies.plan, {
+      model: "gpt-5.6-luna",
+      reasoning: "xhigh",
+    });
+    assert.deepEqual(resetPayload.allowedModels, settings.allowedModels);
+    assert.deepEqual(resetPayload.stagePolicies.scouts, settings.stagePolicies.scouts);
+    assert.deepEqual(settings.stagePolicies.plan, { model: "gpt-5.6-sol", reasoning: "max" });
+
+    const unavailable = validatePolicyDraft(
+      { model: "gpt-5.6-sol", reasoning: "max" },
+      null,
+      settings.allowedModels,
+    );
+    assert.equal(unavailable.valid, false);
+    assert.match(unavailable.message, /catalog is unavailable/i);
+  });
+});
