diff --git a/src/components/PolicyEditor.tsx b/src/components/PolicyEditor.tsx
new file mode 100644
index 0000000..629d34e
--- /dev/null
+++ b/src/components/PolicyEditor.tsx
@@ -0,0 +1,283 @@
+import { CheckCircle, WarningCircle } from "@phosphor-icons/react";
+import { useEffect, useMemo, useState } from "react";
+import type {
+  RuntimeAgentPolicy,
+  RuntimeModelCatalog,
+  RuntimeModelOption,
+  RuntimeSettings,
+} from "../domain";
+import { Button } from "./Primitives";
+
+export type RuntimeSettingsPayload = Pick<
+  RuntimeSettings,
+  "allowedModels" | "defaultModel" | "defaultReasoning" | "stagePolicies"
+>;
+
+export type PolicyEditorSaveState = "idle" | "saving" | "saved" | "error";
+
+export interface PolicyEditorProps {
+  /** The role shown to the user, such as `plan` or `scout-schema`. */
+  roleId: string;
+  roleLabel: string;
+  settings: RuntimeSettingsPayload;
+  catalog?: RuntimeModelCatalog | null;
+  onSave: (settings: RuntimeSettingsPayload) => Promise<void>;
+  /** Optional override for callers that use a role id outside the workflow taxonomy. */
+  policyId?: string;
+  /** Use this for deterministic harness-owned roles. Approval is deterministic by default. */
+  deterministic?: boolean;
+}
+
+export interface PolicyDraftValidation {
+  valid: boolean;
+  message: string | null;
+  model: RuntimeModelOption | null;
+}
+
+export function policyIdForRole(roleId: string, policyId?: string): string | null {
+  if (roleId === "approval") return null;
+  if (roleId.startsWith("scout-")) return "scouts";
+  return policyId ?? roleId;
+}
+
+export function availablePolicyModels(
+  catalog: RuntimeModelCatalog | null | undefined,
+  allowedModels: string[],
+): RuntimeModelOption[] {
+  if (!catalog) return [];
+  const allowed = new Set(allowedModels);
+  return catalog.models.filter((model) => allowed.has(model.id));
+}
+
+export function validatePolicyDraft(
+  draft: RuntimeAgentPolicy,
+  catalog: RuntimeModelCatalog | null | undefined,
+  allowedModels: string[],
+): PolicyDraftValidation {
+  if (!catalog) {
+    return { valid: false, message: "The local model catalog is unavailable. Refresh runtime status and try again.", model: null };
+  }
+
+  const model = catalog.models.find((candidate) => candidate.id === draft.model) ?? null;
+  if (!model || !allowedModels.includes(draft.model)) {
+    return { valid: false, message: "Choose a model from the configured local catalog allowlist.", model };
+  }
+  if (!model.reasoningLevels.includes(draft.reasoning)) {
+    return {
+      valid: false,
+      message: `“${draft.reasoning}” is not supported by ${model.label}. Choose one of its catalog-backed reasoning levels.`,
+      model,
+    };
+  }
+  return { valid: true, message: null, model };
+}
+
+export function policySettingsPayload(
+  settings: RuntimeSettingsPayload,
+  policyId: string,
+  policy: RuntimeAgentPolicy,
+): RuntimeSettingsPayload {
+  return {
+    allowedModels: [...settings.allowedModels],
+    defaultModel: settings.defaultModel,
+    defaultReasoning: settings.defaultReasoning,
+    stagePolicies: {
+      ...settings.stagePolicies,
+      [policyId]: { model: policy.model, reasoning: policy.reasoning },
+    },
+  };
+}
+
+function initialPolicy(settings: RuntimeSettingsPayload, policyId: string): RuntimeAgentPolicy {
+  return settings.stagePolicies[policyId] ?? {
+    model: settings.defaultModel,
+    reasoning: settings.defaultReasoning,
+  };
+}
+
+function errorMessage(reason: unknown): string {
+  return reason instanceof Error ? reason.message : "The policy could not be saved.";
+}
+
+export function PolicyEditor({
+  roleId,
+  roleLabel,
+  settings,
+  catalog,
+  onSave,
+  policyId: policyIdOverride,
+  deterministic: deterministicOverride,
+}: PolicyEditorProps) {
+  const policyId = policyIdForRole(roleId, policyIdOverride);
+  const deterministic = deterministicOverride ?? roleId === "approval";
+  const [draft, setDraft] = useState<RuntimeAgentPolicy>(() =>
+    policyId ? initialPolicy(settings, policyId) : { model: "", reasoning: "" },
+  );
+  const [saveState, setSaveState] = useState<PolicyEditorSaveState>("idle");
+  const [error, setError] = useState<string | null>(null);
+
+  useEffect(() => {
+    if (policyId) setDraft(initialPolicy(settings, policyId));
+    setSaveState("idle");
+    setError(null);
+  }, [policyId, settings]);
+
+  const modelOptions = useMemo(
+    () => availablePolicyModels(catalog, settings.allowedModels),
+    [catalog, settings.allowedModels],
+  );
+  const selectedModel = catalog?.models.find((model) => model.id === draft.model) ?? null;
+  const validation = useMemo(
+    () =>
+      policyId
+        ? validatePolicyDraft(draft, catalog, settings.allowedModels)
+        : { valid: true, message: null, model: null },
+    [catalog, draft, policyId, settings.allowedModels],
+  );
+
+  if (deterministic || !policyId) {
+    return (
+      <section className="policy-editor" aria-labelledby={`policy-editor-${roleId}`}>
+        <h3 id={`policy-editor-${roleId}`}>{roleLabel} policy</h3>
+        <p className="settings-section__intro">
+          Human Approval is deterministic and harness-owned. It has no model or reasoning policy to edit.
+        </p>
+      </section>
+    );
+  }
+
+  const editablePolicyId = policyId;
+  const scoutPolicy = roleId.startsWith("scout-");
+
+  function updateDraft(next: RuntimeAgentPolicy) {
+    setDraft(next);
+    setSaveState("idle");
+    setError(null);
+  }
+
+  async function savePolicy(nextPolicy = draft) {
+    const nextValidation = validatePolicyDraft(nextPolicy, catalog, settings.allowedModels);
+    if (!nextValidation.valid) {
+      setSaveState("error");
+      setError(nextValidation.message);
+      return;
+    }
+
+    setSaveState("saving");
+    setError(null);
+    try {
+      await onSave(policySettingsPayload(settings, editablePolicyId, nextPolicy));
+      setSaveState("saved");
+    } catch (reason) {
+      setSaveState("error");
+      setError(errorMessage(reason));
+    }
+  }
+
+  async function resetToGlobalDefault() {
+    const resetPolicy = {
+      model: settings.defaultModel,
+      reasoning: settings.defaultReasoning,
+    };
+    updateDraft(resetPolicy);
+    await savePolicy(resetPolicy);
+  }
+
+  return (
+    <section className="policy-editor" aria-labelledby={`policy-editor-${roleId}`}>
+      <div className="settings-section__head">
+        <span>
+          <h3 id={`policy-editor-${roleId}`}>{roleLabel} policy</h3>
+          <p>
+            Choose only models enabled in the local runtime catalog. Reasoning choices come from the selected model.
+          </p>
+        </span>
+      </div>
+      {scoutPolicy ? (
+        <p className="settings-section__intro">
+          This scout edits the shared <code>scouts</code> policy. The same model and reasoning apply to every Goose scout.
+        </p>
+      ) : null}
+      <div className="role-policy-row">
+        <span>
+          <strong>{roleLabel}</strong>
+          <small>Policy id: {editablePolicyId}</small>
+        </span>
+        <label>
+          Model
+          <select
+            aria-label={`${roleLabel} model`}
+            value={draft.model}
+            disabled={!catalog || saveState === "saving"}
+            onChange={(event) => {
+              const model = catalog?.models.find((candidate) => candidate.id === event.target.value);
+              updateDraft({
+                model: event.target.value,
+                reasoning: model?.reasoningLevels.includes(draft.reasoning)
+                  ? draft.reasoning
+                  : model?.defaultReasoning ?? "",
+              });
+            }}
+          >
+            {!modelOptions.some((model) => model.id === draft.model) ? (
+              <option value={draft.model} disabled>
+                {draft.model || "No model selected"}
+              </option>
+            ) : null}
+            {modelOptions.map((model) => (
+              <option key={model.id} value={model.id}>
+                {model.label}
+              </option>
+            ))}
+          </select>
+        </label>
+        <label>
+          Reasoning
+          <select
+            aria-label={`${roleLabel} reasoning`}
+            value={draft.reasoning}
+            disabled={!selectedModel || saveState === "saving"}
+            onChange={(event) => updateDraft({ ...draft, reasoning: event.target.value })}
+          >
+            {selectedModel?.reasoningLevels.map((level) => (
+              <option key={level} value={level}>
+                {level}
+              </option>
+            ))}
+          </select>
+        </label>
+      </div>
+      <p className="settings-section__intro">
+        Applies to new tasks only. Existing tasks retain their snapshotted policy.
+      </p>
+      <div className="detail-panel__actions">
+        <Button type="button" tone="secondary" disabled={saveState === "saving"} onClick={() => void resetToGlobalDefault()}>
+          Reset to global default
+        </Button>
+        <Button
+          type="button"
+          tone="primary"
+          disabled={saveState === "saving" || !validation.valid}
+          onClick={() => void savePolicy()}
+        >
+          {saveState === "saving" ? "Saving…" : "Save policy"}
+        </Button>
+      </div>
+      {validation.message && !error ? (
+        <p className="dialog-error" role="alert">
+          <WarningCircle aria-hidden size={14} weight="fill" /> {validation.message}
+        </p>
+      ) : null}
+      {saveState === "saved" ? (
+        <p className="saved-note" role="status">
+          <CheckCircle aria-hidden size={14} weight="fill" /> Policy saved for new tasks.
+        </p>
+      ) : null}
+      {error ? (
+        <p className="dialog-error" role="alert">
+          <WarningCircle aria-hidden size={14} weight="fill" /> {error}
+        </p>
+      ) : null}
+    </section>
+  );
+}
