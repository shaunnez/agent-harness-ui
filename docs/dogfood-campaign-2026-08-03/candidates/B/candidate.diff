@@ -0,0 +1,480 @@
+import type {
+  RuntimeAgentPolicy,
+  RuntimeApproval,
+  RuntimeArtifact,
+  RuntimeFocusedTestEvidence,
+  RuntimeGrillQuestion,
+  RuntimeSettings,
+  RuntimeTask,
+  RuntimeWorkPackage,
+  StageId,
+} from "../domain";
+import promptSource from "../../server/prompts.mjs?raw";
+import scoutSource from "../../server/scouts.mjs?raw";
+import parserSource from "../../server/structured-output.mjs?raw";
+
+/**
+ * These names are references to real TypeScript boundary types, not runtime
+ * validators. Keeping the map here gives consumers a type-safe vocabulary
+ * without pretending that the JavaScript prompt/parser modules have types
+ * they do not currently export.
+ */
+export type SkillBoundaryTypeName =
+  | "RuntimeAgentPolicy"
+  | "RuntimeApproval"
+  | "RuntimeArtifact"
+  | "RuntimeFocusedTestEvidence"
+  | "RuntimeGrillQuestion[]"
+  | "RuntimeSettings"
+  | "RuntimeTask"
+  | "RuntimeWorkPackage[]";
+
+export type SkillBoundaryTypeMap = {
+  RuntimeAgentPolicy: RuntimeAgentPolicy;
+  RuntimeApproval: RuntimeApproval;
+  RuntimeArtifact: RuntimeArtifact;
+  RuntimeFocusedTestEvidence: RuntimeFocusedTestEvidence;
+  "RuntimeGrillQuestion[]": RuntimeGrillQuestion[];
+  RuntimeSettings: RuntimeSettings;
+  RuntimeTask: RuntimeTask;
+  "RuntimeWorkPackage[]": RuntimeWorkPackage[];
+};
+
+export type SkillBoundaryValue<Name extends SkillBoundaryTypeName> = SkillBoundaryTypeMap[Name];
+
+export type SkillBoundaryRole = "input" | "output" | "configuration" | "policy" | "persisted";
+
+export interface SkillTypeReference<Name extends SkillBoundaryTypeName = SkillBoundaryTypeName> {
+  layer: "typescript-api";
+  role: SkillBoundaryRole;
+  typeName: Name;
+  sourceFile: "src/domain.ts";
+  symbol: Name;
+  description: string;
+}
+
+export type JavascriptSourceLayer = "prompt-source" | "parser-source";
+
+export interface JavascriptSourceReference {
+  layer: JavascriptSourceLayer;
+  filename: "server/prompts.mjs" | "server/scouts.mjs" | "server/structured-output.mjs";
+  symbol: string;
+  lineStart: number;
+  lineEnd: number;
+  excerpt: string;
+  description: string;
+}
+
+export interface SkillParserReference extends JavascriptSourceReference {
+  layer: "parser-source";
+  parsedType?: SkillBoundaryTypeName;
+}
+
+export interface SkillPromptReference extends JavascriptSourceReference {
+  layer: "prompt-source";
+}
+
+export interface SkillPersistedReference {
+  layer: "persisted-artifact" | "persisted-record";
+  type: SkillTypeReference;
+  field: "artifacts" | "approvals";
+  description: string;
+}
+
+export interface SkillUiPresentationReference {
+  layer: "ui-presentation";
+  uiOnly: true;
+  typeName: "SkillDetailPresentation";
+  sourceFile: "src/components/LibraryScreens.tsx";
+  symbol: "SkillsScreen";
+  description: string;
+}
+
+export interface SkillContract {
+  id: StageId;
+  skill: string;
+  label: string;
+  provider: "codex" | "harness";
+  input: SkillTypeReference[];
+  output: SkillTypeReference[];
+  configuration: {
+    settings: SkillTypeReference<"RuntimeSettings">;
+    policy: SkillTypeReference<"RuntimeAgentPolicy">;
+  } | null;
+  prompts: SkillPromptReference[];
+  parsers: SkillParserReference[];
+  persistedArtifact: SkillPersistedReference | null;
+  persistedRecords: SkillPersistedReference[];
+  presentation: SkillUiPresentationReference;
+  notes: string[];
+}
+
+const DOMAIN_SOURCE = "src/domain.ts" as const;
+const UI_SOURCE = "src/components/LibraryScreens.tsx" as const;
+const PROMPT_FILENAME = "server/prompts.mjs" as const;
+const SCOUT_FILENAME = "server/scouts.mjs" as const;
+const PARSER_FILENAME = "server/structured-output.mjs" as const;
+
+function typeReference<Name extends SkillBoundaryTypeName>(
+  role: SkillBoundaryRole,
+  typeName: Name,
+  description: string,
+): SkillTypeReference<Name> {
+  return {
+    layer: "typescript-api",
+    role,
+    typeName,
+    sourceFile: DOMAIN_SOURCE,
+    symbol: typeName,
+    description,
+  };
+}
+
+function presentation(description: string): SkillUiPresentationReference {
+  return {
+    layer: "ui-presentation",
+    uiOnly: true,
+    typeName: "SkillDetailPresentation",
+    sourceFile: UI_SOURCE,
+    symbol: "SkillsScreen",
+    description,
+  };
+}
+
+function excerpt(source: string, symbol: string, limit = 2_400) {
+  const markers = [`export function ${symbol}`, `export const ${symbol}`, `function ${symbol}`];
+  const start = markers.map((marker) => source.indexOf(marker)).find((index) => index >= 0) ?? -1;
+  if (start < 0) {
+    throw new Error(`Skill provenance source no longer contains ${symbol}.`);
+  }
+  const text = source.slice(start, start + limit).trim();
+  const lineStart = source.slice(0, start).split("\n").length;
+  return {
+    lineStart,
+    lineEnd: lineStart + text.split("\n").length - 1,
+    excerpt: text,
+  };
+}
+
+function prompt(
+  filename: typeof PROMPT_FILENAME | typeof SCOUT_FILENAME,
+  source: string,
+  symbol: string,
+  description: string,
+): SkillPromptReference {
+  return {
+    layer: "prompt-source",
+    filename,
+    symbol,
+    description,
+    ...excerpt(source, symbol),
+  };
+}
+
+function parser(
+  symbol: string,
+  description: string,
+  parsedType?: SkillBoundaryTypeName,
+  filename: typeof PARSER_FILENAME | typeof SCOUT_FILENAME = PARSER_FILENAME,
+  source: string = parserSource,
+): SkillParserReference {
+  return {
+    layer: "parser-source",
+    filename,
+    symbol,
+    description,
+    parsedType,
+    ...excerpt(source, symbol),
+  };
+}
+
+function modelConfiguration(): SkillContract["configuration"] {
+  return {
+    settings: typeReference(
+      "configuration",
+      "RuntimeSettings",
+      "The current runtime settings provide the catalog-backed policy and pricing context to the harness.",
+    ),
+    policy: typeReference(
+      "policy",
+      "RuntimeAgentPolicy",
+      "The task snapshot selects the model and reasoning passed to the Codex runtime for this skill.",
+    ),
+  };
+}
+
+function modelInput(): SkillTypeReference<"RuntimeTask">[] {
+  return [
+    typeReference(
+      "input",
+      "RuntimeTask",
+      "The persisted task, including its approved handoffs and snapshotted agent configuration.",
+    ),
+  ];
+}
+
+function modelOutput(): SkillTypeReference<"RuntimeArtifact">[] {
+  return [
+    typeReference(
+      "output",
+      "RuntimeArtifact",
+      "The Markdown result and usage/context provenance retained on the task artifact boundary.",
+    ),
+  ];
+}
+
+function persistedArtifact(description: string): SkillPersistedReference {
+  return {
+    layer: "persisted-artifact",
+    field: "artifacts",
+    type: typeReference("persisted", "RuntimeArtifact", description),
+    description,
+  };
+}
+
+function baseModelContract(
+  id: Exclude<StageId, "approval">,
+  skill: string,
+  label: string,
+  prompts: SkillPromptReference[],
+  parsers: SkillParserReference[],
+  notes: string[] = [],
+): SkillContract {
+  const artifactDescription = `The ${label} Markdown handoff is retained as a RuntimeArtifact; parser results, when present, are normalized before persistence.`;
+  return {
+    id,
+    skill,
+    label,
+    provider: "codex",
+    input: modelInput(),
+    output: modelOutput(),
+    configuration: modelConfiguration(),
+    prompts,
+    parsers,
+    persistedArtifact: persistedArtifact(artifactDescription),
+    persistedRecords: [],
+    presentation: presentation(
+      "A UI-only detail projection combines this registry metadata with recorded RuntimeArtifact usage; it is not an API or persisted contract.",
+    ),
+    notes,
+  };
+}
+
+const stagePrompt = (stageId: Exclude<StageId, "approval">) => [
+  prompt(
+    PROMPT_FILENAME,
+    promptSource,
+    "buildStagePrompt",
+    `Builds the ${stageId} investigation or handoff prompt.`,
+  ),
+  prompt(
+    PROMPT_FILENAME,
+    promptSource,
+    "buildStageRequest",
