# The research service's settings. Copy to .env.local (ignored by git) for a local run; in Azure
# these come from the container's environment and Key Vault. `npm run dev:research-service` also
# reads ~/.config/eversor-research.env (the provider keys) and the harness's .env.research.local
# (PlanCheck's local rate-library settings) when they exist.

# Postgres. pglite:<directory> runs Postgres inside the process for a local run, no Docker.
RESEARCH_DATABASE_URL=pglite:.data/research-pg
# RESEARCH_DATABASE_URL=postgres://research:…@localhost:5432/research

# Loopback keeps the review console's routes on; any other host turns them off until sign-in.
RESEARCH_SERVICE_HOST=127.0.0.1
RESEARCH_SERVICE_PORT=4400

# Who may send batches: name:sha256-of-token, comma separated.
# `npm run client-token -w @eversor/research-service -- plancheck` makes a token and its entry.
RESEARCH_SERVICE_CLIENTS=

# DeepSeek on a US-hosted provider only: fireworks-us/… (default) or baseten/….
# RESEARCH_MODEL=fireworks-us/accounts/fireworks/routers/deepseek-v4p1-flash-us
# FIREWORKS_API_KEY=      (or BASETEN_API_KEY), and PARALLEL_API_KEY for web search.

# Pacing: runs calling the model at once start here, grow by one after 20 clean calls, and halve
# on a 429. Fireworks' new-account limit fits about six.
RESEARCH_INITIAL_CONCURRENT_RUNS=3
RESEARCH_MAX_CONCURRENT_RUNS=6
RESEARCH_RUNS_PER_QUESTION=5

# The standing research project PlanCheck's batches are asked in.
RESEARCH_PROJECT_ID=plancheck
RESEARCH_PROJECT_NAME=PlanCheck

# QV comes from PlanCheck's rate library, as in the harness (RESEARCH_QV_SOURCE=plancheck and
# RESEARCH_PLANCHECK_*), read by packages/research-engine/src/qv-plancheck.mjs.
