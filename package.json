{
  "name": "agent-harness-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "node server/index.mjs",
    "lint": "biome lint src",
    "format:check": "biome format src",
    "typecheck": "tsc --noEmit",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test": "node --test tests/api.test.mjs tests/atlas-model.test.mjs tests/campaign-export.test.mjs tests/claude-runtime.test.mjs tests/evaluation.test.mjs tests/git-worktree.test.mjs tests/orchestrator.test.mjs tests/routes.test.mjs tests/runtime.test.mjs tests/onboarding.test.mjs tests/store.test.mjs tests/verification.test.mjs",
    "test:api": "node --test tests/api.test.mjs",
    "test:orchestrator": "node --test tests/orchestrator.test.mjs",
    "test:runtime": "node --test tests/runtime.test.mjs tests/api.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "^7.0.2"
  }
}
