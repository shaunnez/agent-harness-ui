# Copy to .env.harness.local (git-ignored). compose.yaml reads it when present.
# Fill in only what you use. Never put an OpenAI or Anthropic API key here: the Codex and
# Claude runtimes are subscription-only and refuse API-key logins.

# Suggested default repository for new projects (a clone inside the container).
# AGENT_HARNESS_REPOSITORY=/repos/agent-harness-ui

# Extra hostnames/origins the companion accepts, beyond loopback. Needed only behind a name,
# for example `tailscale serve` on the Azure VM.
# AGENT_HARNESS_ALLOWED_HOSTS=harness.example.ts.net
# AGENT_HARNESS_ALLOWED_ORIGINS=

# Verification concurrency (default: half the container's cores).
# AGENT_HARNESS_VERIFICATION_CONCURRENCY=4

# Linear intake (docs/integrations/linear.md). The config file lives in the data volume.
# AGENT_HARNESS_LINEAR_CONFIG=/app/.data/linear-config.local.json
# LINEAR_CLIENT_SECRET=
# LINEAR_WEBHOOK_SECRET=
